@page "/"

@using BlazorConverter.Logic

<h3>Unit Converter: Full Stack Demo</h3>

<div class="card p-4 shadow-sm">
    
    @* --- SELECCIÓN DEL TIPO DE CONVERSIÓN --- *@
    <div class="mb-4">
        <label for="conversionType" class="form-label">Select Conversion Type:</label>
        @* @bind-value enlaza el select con la variable C# ConversionType *@
        <select class="form-select" @bind="ConversionType">
            <option value="1">1. Length (Inches to Meters)</option>
            <option value="2">2. Temperature (Fahrenheit to Celsius)</option>
        </select>
    </div>

    @* --- INPUT DINÁMICO --- *@
    <div class="mb-3">
        @* Mostramos la etiqueta correcta basada en la selección (ConversionType) *@
        <label for="inputValue" class="form-label">
            @if (ConversionType == 1)
            {
                <span>Enter value in **Inches**:</span>
            }
            else
            {
                <span>Enter value in **Fahrenheit**:</span>
            }
        </label>
        
        @* El input siempre se enlaza a InputValue *@
        <input 
            type="number" 
            class="form-control" 
            @bind-value="InputValue" 
            placeholder="Enter a numeric value..."
        />
    </div>

    @* --- BOTÓN DINÁMICO --- *@
    <button class="btn btn-primary w-100" @onclick="PerformConversion">
        @if (ConversionType == 1)
        {
            <span>Convert to Meters</span>
        }
        else
        {
            <span>Convert to Celsius</span>
        }
    </button>
</div>

@* --- RESULTADO DINÁMICO --- *@
@if (ConversionResult.HasValue)
{
    <div class="alert alert-success mt-3" role="alert">
        <strong>Result:</strong> @InputValue 
        @if (ConversionType == 1)
        {
            <span> inches are equal to **@ConversionResult.Value.ToString("F2")** meters.</span>
        }
        else
        {
            <span> Fahrenheit are equal to **@ConversionResult.Value.ToString("F2")** Celsius.</span>
        }
    </div>
}


@code {
    // 1. Variable para el input genérico (se usará para pulgadas o Fahrenheit)
    private double InputValue { get; set; } = 0;
    private double? ConversionResult { get; set; }
    
    // 2. Variable para la selección (usamos un enum simple, 1=Length, 2=Temp)
    private int ConversionType { get; set; } = 1; // Por defecto, es Length (1)

    // 3. Método actualizado para manejar ambos tipos de conversión
    private void PerformConversion()
    {
        // Validamos que el input sea positivo para Longitud, pero permitimos cualquier número para Temperatura
        if (ConversionType == 1 && InputValue <= 0)
        {
            ConversionResult = null;
            return;
        }

        switch (ConversionType)
        {
            case 1: // Length (Pulgadas a Metros)
                ConversionResult = ConverterLogic.ConvertLength(InputValue);
                break;
            case 2: // Temperature (Fahrenheit a Celsius)
                ConversionResult = ConverterLogic.ConvertTemp(InputValue);
                break;
            default:
                ConversionResult = null;
                break;
        }
    }
}